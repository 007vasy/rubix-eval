# syntax=docker/dockerfile:1
# Public Cloud Run image: Python + static web. No Chrome / Puppeteer.
#   gcloud run deploy rubix-eval --source . --allow-unauthenticated

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    RUBIX_TRUSTED_RENDERER=0 \
    RUBIX_LANE=open \
    RUBIX_WEB_ACCESS=1 \
    RUBIX_HARNESS=browser \
    PORT=8080

WORKDIR /opt/rubix-eval

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE /opt/rubix-eval/
COPY src /opt/rubix-eval/src
COPY web /opt/rubix-eval/web
COPY evals /opt/rubix-eval/evals
COPY docs /opt/rubix-eval/docs

RUN pip install --no-cache-dir /opt/rubix-eval google-cloud-storage

EXPOSE 8080
CMD ["sh", "-c", "python -m rubix_eval visual --no-open --host 0.0.0.0 --port ${PORT}"]
